{
  "name": "www",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "start": "vite preview",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "postinstall": "npm run cf-typegen && cd ../.. && pnpm run www:build-deps",
    "clean": "rm -rf .tanstack .turbo .wrangler dist node_modules",
    "machine-translate": "inlang machine translate --project project.inlang",
    "paraglide:compile": "node --experimental-strip-types ./scripts/compile-paraglide.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.42.3",
    "@fontsource-variable/caveat": "5.2.8",
