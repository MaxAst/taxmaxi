    "@fontsource/geist": "5.2.8",
    "@fontsource/geist-mono": "5.2.7",
    "@fontsource/kanit": "5.2.8",
    "@posthog/react": "1.10.3",
    "@remixicon/react": "4.9.0",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/ai": "0.38.0",
